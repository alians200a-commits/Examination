{
  "name": "arabic-examination-studio",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "description": "Iraqi exam editor with exact A4 pages, structured+free content, images, Arabic/English math and configurable grades",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
